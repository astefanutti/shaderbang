//
// Glow pyramid, upsample + accumulate step: out[L] = tent3x3(out[L+1]) + weight[L] * level[L].
// Run from the coarsest level up to level 1; the final composite reads level 1 (bilinear x2).

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D coarseTex;                 // accumulated level L+1 (bilinear)
layout(binding = 1) uniform sampler2D levelTex;                   // downsampled level L
layout(rgba16f, binding = 0) uniform writeonly image2D dstImg;    // accumulated level L
uniform float levelWeight;                                        // APSF-fitted weight of level L
uniform float radius;                                             // tent radius in texels of the coarse level
uniform int hasCoarse;                                            // 0 at the coarsest level: no tent term

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(dstImg);
    if (dst.x >= dstSize.x || dst.y >= dstSize.y) return;
    vec2 uv = (vec2(dst) + 0.5) / vec2(dstSize);
    vec2 texel = radius / vec2(textureSize(coarseTex, 0));

    vec3 s = textureLod(coarseTex, uv + texel * vec2(-1.0,  1.0), 0.0).rgb * 1.0
           + textureLod(coarseTex, uv + texel * vec2( 0.0,  1.0), 0.0).rgb * 2.0
           + textureLod(coarseTex, uv + texel * vec2( 1.0,  1.0), 0.0).rgb * 1.0
           + textureLod(coarseTex, uv + texel * vec2(-1.0,  0.0), 0.0).rgb * 2.0
           + textureLod(coarseTex, uv,                            0.0).rgb * 4.0
           + textureLod(coarseTex, uv + texel * vec2( 1.0,  0.0), 0.0).rgb * 2.0
           + textureLod(coarseTex, uv + texel * vec2(-1.0, -1.0), 0.0).rgb * 1.0
           + textureLod(coarseTex, uv + texel * vec2( 0.0, -1.0), 0.0).rgb * 2.0
           + textureLod(coarseTex, uv + texel * vec2( 1.0, -1.0), 0.0).rgb * 1.0;
    s *= (hasCoarse == 1) ? (1.0 / 16.0) : 0.0;
    vec3 level = textureLod(levelTex, uv, 0.0).rgb;
    imageStore(dstImg, dst, vec4(s + levelWeight * level, 1.0));
}
